# stdio only: inject credentials into your MCP client's environment.
PUSH9_BASE_URL=https://push9.top
PUSH9_TOKEN=aip_replace_with_your_token
PUSH9_TOPIC=server-alerts
PUSH9_MCP_TRANSPORT=stdio
# HTTP mode uses EACH caller's Authorization header, never PUSH9_TOKEN.
# PUSH9_MCP_TRANSPORT=http
# PUSH9_MCP_HOST=127.0.0.1
# PUSH9_MCP_PORT=3110
# PUSH9_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# PUSH9_MCP_ALLOWED_ORIGINS=
